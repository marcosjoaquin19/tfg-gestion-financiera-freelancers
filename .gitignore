# Variables de entorno - NUNCA subir al repositorio
.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Docker
*.log

# VS Code
.vscode/

# Mac
.DS_Store

# Frontend
frontend/node_modules/
frontend/build/

# Documentación y entregables (solo código en el repo)
docs/
*.pdf
*.html

# Capturas para el video demo (generadas, no son código)
demo_capturas/
# La tesis aprobada se conserva localmente en defensa_final/tesis/ pero no
# se publica en el repositorio.
defensa_final/tesis/

# PDF de lectura: se regeneran con gen_pdfs_lectura.py, no se versionan.
defensa_final/lectura/

# Material local de la revisión final (prompts e informes, no es código).
defensa_final/revision_final/

# El video institucional en H.264, que el generador de filminas mete adentro de
# la filmina 10 (se rehace con ffmpeg: ver defensa_final/slides/fuentes/LEEME.md).
defensa_final/video/*.mp4

# La copia en Keynote (.key) se genera a mano desde el .pptx (Archivo > Guardar en Keynote).
defensa_final/slides/*.key

# Claves de la copia del link público: las genera prender_link.sh la primera vez.
defensa_final/link_publico/.env.publico
